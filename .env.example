# ---------------------------------------------------------------------------
# Definite Assurance Claims Portal — environment configuration
# Copy this file to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# Session cookie signing secret — any long random string (32+ chars)
SESSION_SECRET=change-this-to-a-long-random-string-please

# ---------------------------------------------------------------------------
# DocuSeal (self-hosted) — e-signature for demand letters, discharge vouchers,
# client consent forms, and service-provider engagement letters.
#
# 1. Deploy DocuSeal (https://www.docuseal.com/on-premises) or use your
#    existing self-hosted instance.
# 2. Generate an API key: DocuSeal → Settings → API.
# 3. Create one template per document type below (Settings → Templates, or
#    upload a PDF/DOCX and drop signature fields on it), then copy each
#    template's numeric ID into the corresponding variable.
# ---------------------------------------------------------------------------

# Base URL of your self-hosted DocuSeal instance, no trailing slash
# e.g. https://docuseal.definiteassurance.co.ke
DOCUSEAL_HOST=

# API key from DocuSeal → Settings → API (used server-side only, never
# exposed to the browser)
DOCUSEAL_API_KEY=

# Template IDs — one per signing workflow. Leave blank to keep that
# workflow in "not configured" demo mode (the UI explains what's missing).
DOCUSEAL_TEMPLATE_SETTLEMENT_DISCHARGE=
DOCUSEAL_TEMPLATE_DEMAND_LETTER=
DOCUSEAL_TEMPLATE_ENGAGEMENT_LETTER=

# Claim-form templates — one per real Definite Assurance paper form
# (see lib/claim-forms.ts). Each is used during claim submission for the
# matching claim type; leave any blank to keep that form in demo mode.
DOCUSEAL_TEMPLATE_FORM_MOTOR_ACCIDENT=
DOCUSEAL_TEMPLATE_FORM_WINDSCREEN=
DOCUSEAL_TEMPLATE_FORM_ALL_RISKS=
DOCUSEAL_TEMPLATE_FORM_BAGGAGE_PROPERTY=
DOCUSEAL_TEMPLATE_FORM_WIBA=
DOCUSEAL_TEMPLATE_FORM_PERSONAL_ACCIDENT=
DOCUSEAL_TEMPLATE_FORM_INVESTIGATOR_NOTIFICATION=
DOCUSEAL_TEMPLATE_FORM_GENERAL_CLAIM=
