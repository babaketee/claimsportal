{
  "datasets": [
    {
      "name": "auto_approval_funnel",
      "displayName": "Auto-Approval Funnel",
      "queryLines": [
        "SELECT\n",
        "  'Total Claims' AS stage,\n",
        "  COUNT(*) AS count\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Low Severity (<$3k)',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "WHERE\n",
        "  damage_amount < 3000\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Not Suspicious',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "WHERE\n",
        "  damage_amount < 3000\n",
        "  AND is_suspicious_flag = FALSE\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Reported Same Day',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "WHERE\n",
        "  damage_amount < 3000\n",
        "  AND is_suspicious_flag = FALSE\n",
        "  AND report_lag_days <= 1\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Auto-Approvable',\n",
        "  COUNT(*)\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "WHERE\n",
        "  is_auto_approvable = TRUE\n",
        "ORDER BY\n",
        "  count DESC"
      ]
    },
    {
      "name": "severity_status",
      "displayName": "Severity vs Status",
      "queryLines": [
        "SELECT\n",
        "  claim_severity,\n",
        "  claim_status,\n",
        "  COUNT(*) AS claim_count\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "monthly_claims",
      "displayName": "Monthly Claims Volume",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('month', claim_date) AS month,\n",
        "  claim_type,\n",
        "  COUNT(*) AS total_claims,\n",
        "  SUM(net_claim_amount) AS total_payout\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "claims_by_state",
      "displayName": "Claims by State",
      "queryLines": [
        "SELECT\n",
        "  state,\n",
        "  COUNT(*) AS total_claims,\n",
        "  SUM(net_claim_amount) AS total_payout,\n",
        "  ROUND(AVG(damage_amount), 0) AS avg_damage\n",
        "FROM\n",
        "  workspace.default.claims_silver\n",
        "GROUP BY\n",
        "  state\n",
        "ORDER BY\n",
        "  total_claims DESC"
      ]
    },
    {
      "name": "fraud_risk",
      "displayName": "Fraud Risk Distribution",
      "queryLines": [
        "SELECT\n",
        "  fraud_risk_tier,\n",
        "  claim_type,\n",
        "  COUNT(*) AS claim_count,\n",
        "  ROUND(AVG(fraud_score), 1) AS avg_fraud_score,\n",
        "  ROUND(AVG(damage_amount), 0) AS avg_damage\n",
        "FROM\n",
        "  workspace.default.claims_gold_fraud_scores\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "top_adjusters",
      "displayName": "Top Adjusters",
      "queryLines": [
        "SELECT\n",
        "  s.adjuster_id,\n",
        "  COUNT(*) AS claims_handled,\n",
        "  ROUND(AVG(s.damage_amount), 0) AS avg_damage,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN s.claim_status = 'Settled' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS settled_count,\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN s.is_suspicious_flag THEN f.fraud_score\n",
        "      END\n",
        "    ),\n",
        "    1\n",
        "  ) AS avg_fraud_score_on_suspicious\n",
        "FROM\n",
        "  workspace.default.claims_silver s\n",
        "    JOIN workspace.default.claims_gold_fraud_scores f USING (claim_id)\n",
        "GROUP BY\n",
        "  s.adjuster_id\n",
        "ORDER BY\n",
        "  claims_handled DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_claims,\n",
        "  ROUND(AVG(damage_amount), 2) AS avg_damage_amount,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN claim_status = 'Approved' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS approval_rate_pct,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN is_suspicious_flag = TRUE THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS fraud_rate_pct,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN is_auto_approvable = TRUE THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS auto_approval_rate_pct\n",
        "FROM\n",
        "  workspace.default.claims_silver"
      ]
    }
  ],
